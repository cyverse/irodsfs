#! /usr/bin/env python3

# mount -t irodsfs URL /opt/mount
# [0] /sbin/mount.irodsfs
# [1] URL
# [2] /opt/mount

import os
import sys
import shutil
import subprocess
import time

# Options supported as iRODSFS command-line flags.  mount(8) uses -o for both
# filesystem-specific and generic FUSE options, so an arbitrary key=value must
# not be assumed to be an iRODSFS flag.
IRODSFS_VALUE_OPTIONS = {
    "config",
    "instance_id",
    "log_path",
    "username",
    "client_username",
    "password",
    "read_ahead_max",
    "read_write_max",
    "uid",
    "gid",
    "sys_user",
    "data_root",
    "pool_endpoint",
    "url",
}


def reorder_args(argv):
    options = []
    positional_args = []
    mount_timeout = 60

    i = 1  # skip argv[0] (command name)
    while i < len(argv):
        arg = argv[i]
        if arg == "-o":
            if i + 1 >= len(argv):
                print("missing argument for -o", file=sys.stderr)
                sys.exit(1)
            i += 1
            for opt in argv[i].split(","):
                key, sep, val = opt.partition("=")
                if not sep:
                    # boolean flag
                    if key in ("ro", "readonly"):
                        options.append("--readonly")
                    elif key == "allow_other":
                        # allow_other is an iRODSFS FUSE option, not an
                        # iRODSFS command-line flag.
                        options.extend(["-o", "allow_other"])
                    elif key == "f":
                        options.append("--foreground")
                    else:
                        options.extend(["-o", key])
                else:
                    if key == "mounttimeout":
                        try:
                            mount_timeout = max(int(val), 10)
                        except ValueError as error:
                            raise ValueError("mounttimeout must be an integer") from error
                    elif key in IRODSFS_VALUE_OPTIONS:
                        options.extend([f"--{key}", val])
                    else:
                        # Keep generic FUSE options in their original form.
                        options.extend(["-o", opt])
        else:
            positional_args.append(arg)
        i += 1

    # mount(8) passes the filesystem type as the first positional arg; skip "irodsfs"
    if len(positional_args) > 1 and positional_args[0] == "irodsfs":
        positional_args = positional_args[1:]

    if len(positional_args) < 2:
        raise ValueError("iRODS URL source and mount point are required")
    if len(positional_args) > 2:
        raise ValueError("expected one iRODS URL source and one mount point")

    # iRODSFS now accepts only the mount point as a positional argument. The
    # mount(8) source is the iRODS URL and must be passed through --url.
    source, mount_point = positional_args
    options.extend(["--url", source])
    return options, [mount_point], mount_timeout


def check_mount(mount_point, mount_timeout):
    for _ in range(mount_timeout):
        time.sleep(1)
        try:
            with open("/proc/mounts") as f:
                for line in f:
                    fields = line.split()
                    if (len(fields) >= 3
                            and fields[0].lower() == "irodsfs"
                            and fields[1] == mount_point
                            and fields[2].lower() == "fuse.irodsfs"):
                        return True
        except OSError as e:
            print(f"error reading /proc/mounts: {e}", file=sys.stderr)

    print(f"fuse mount not found for {mount_point!r} after {mount_timeout}s", file=sys.stderr)
    try:
        with open("/proc/mounts") as f:
            print("mount dump >", file=sys.stderr)
            sys.stderr.write(f.read())
            print("mount dump end", file=sys.stderr)
    except OSError:
        pass
    return False


def main(argv):
    irods_bin = shutil.which("irodsfs")
    if not irods_bin:
        print("irodsfs not found in PATH", file=sys.stderr)
        sys.exit(1)

    print(f"found irodsfs > {irods_bin}")

    try:
        options, positional_args, mount_timeout = reorder_args(argv)
    except ValueError as error:
        print(f"invalid mount arguments: {error}", file=sys.stderr)
        sys.exit(1)

    mount_point = os.path.abspath(os.path.expanduser(positional_args[-1]))
    cmd = [irods_bin] + options + positional_args

    # Do not print cmd: --url and --password can contain credentials, and this
    # helper's stdout is commonly captured by mount(8), system logs, or both.
    print(f"starting irodsfs mount at {mount_point}")

    result = subprocess.run(cmd)
    if result.returncode != 0:
        if result.returncode < 0:
            print(f"irodsfs killed by signal {-result.returncode}", file=sys.stderr)
        else:
            print(f"irodsfs exited with code {result.returncode}", file=sys.stderr)
        sys.exit(result.returncode if result.returncode > 0 else 1)

    if not check_mount(mount_point, mount_timeout):
        print("mount not detected after timeout", file=sys.stderr)
        sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main(sys.argv)
